# Copy to .env and fill in. Never commit .env.

# The address people use to reach this server (no trailing slash needed).
WIREBENDER_URL=https://wire.example.org

# The session secret: openssl rand -hex 32
NUXT_APP_SECRET=replace-me-with-64-hex-characters

# At least one sign-in provider pair. Remove the lines of a provider you do not use:
# a pair that is set (even to a placeholder) turns that sign-in on.
NUXT_OAUTH_GITHUB_CLIENT_ID=replace-me-github-client-id
NUXT_OAUTH_GITHUB_CLIENT_SECRET=replace-me-github-client-secret
NUXT_OAUTH_GOOGLE_CLIENT_ID=replace-me-google-client-id
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=replace-me-google-client-secret
