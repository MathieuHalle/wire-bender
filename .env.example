# Copy to .env and fill in. Never commit .env.

# The address people use to reach this server.
WIREBENDER_URL=https://wire.example.org

# On a server: Caddy in front for HTTPS (compose.yaml). Both lines, with the domain of
# WIREBENDER_URL. On your own computer, delete them and use WIREBENDER_URL=http://localhost:3000.
COMPOSE_PROFILES=https
WIREBENDER_DOMAIN=wire.example.org
# The containers' private network is 192.168.213.0/24. If the server reaches a network
# in that range (a VPC, a VPN), pick other first three numbers:
# WIREBENDER_NET=10.213.84

# The session secret: openssl rand -hex 32
# Left empty, the server refuses to start.
NUXT_APP_SECRET=

# GitHub sign-in: fill in both. Empty, and no other provider set, the server refuses to start.
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

# Google sign-in: uncomment and fill in both only if you use it.
# NUXT_OAUTH_GOOGLE_CLIENT_ID=
# NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
