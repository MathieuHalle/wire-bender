{
  "name": "wirebender",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "WIREBENDER_MODE=local nuxt dev --host",
    "dev:public": "WIREBENDER_MODE=public nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "check": "tsx --tsconfig tsconfig.cli.json cli/wirebender.ts check",
    "wirebender": "tsx --tsconfig tsconfig.cli.json cli/wirebender.ts"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.147",
    "@iconify-json/simple-icons": "^1.2.100",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@nuxt/ui": "^4.12.0",
    "@tresjs/cientos": "5.10.1",
    "@tresjs/core": "5.10.1",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "lib0": "0.2.119",
    "nuxt": "^4.6.3",
    "nuxt-auth-utils": "0.6.2",
    "tailwindcss": "^4.3.3",
    "three": "0.187.0",
    "uqr": "0.1.3",
    "vue": "3.5.45",
    "vue-router": "5.4.0",
    "y-protocols": "1.0.7",
    "y-websocket": "3.1.0",
    "yjs": "13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^26.6.6",
    "@types/three": "0.187.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.13.0",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.13"
  }
}
